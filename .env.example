GATEWAY_PORT=8000
USERS_PORT=8001
ORDERS_PORT=8002
ETCD_PORT=2379
ETCD_PEER_PORT=2380
HTTP_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
OBS_INTERVAL_SECONDS=5
OBS_SNAPSHOT_TTL_SECONDS=30

# fake só verifica o pipeline; não realiza inferência nem substitui uma LLM.
OBS_LLM_PROVIDER=fake
# Para um endpoint Chat Completions: definir langchain, URL base ou completa, modelo e chave.
# OBS_LLM_PROVIDER=langchain
# OBS_LLM_URL=http://host.docker.internal:11434/v1/chat/completions
# OBS_LLM_MODEL=nome-do-modelo
# OBS_LLM_API_KEY=
OBS_LLM_TIMEOUT_SECONDS=45